# ==============================================================================
# Farm2Home Backend Environment Configuration (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env` in the `backend/` folder:
#    cp .env.example .env (or copy manually)
# 2. Replace the DATABASE_URL placeholder with your actual Neon PostgreSQL connection string.
#    You can find your connection string in the Neon Console (https://console.neon.tech)
#    under "Connection Details" -> "Connection string" (Pooled or Direct).
# ==============================================================================

# Server Port
PORT=5000

# Neon PostgreSQL Database Connection String
# Example format from Neon:
DATABASE_URL=postgresql://[user]:[password]@[endpoint-id].pooler.[region].neon.tech/[dbname]?sslmode=require
